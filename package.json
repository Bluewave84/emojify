{
  "name": "bluewave84/emojify",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tokens": "node scripts/generate-tokens.mjs",
    "emoji-color-tree": "tsx --tsconfig tsconfig.scripts.json scripts/generate-emoji-color-tree.ts",
    "build-sprite": "svg-sprite -c svg-sprite.config.json svg/*.svg",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "csv-report": "tsx --tsconfig tsconfig.scripts.json tmp/emoji-color-tree/report.ts"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.3",
    "@taiga-ui/addon-mobile": "^5.29.0",
    "@taiga-ui/addon-table": "^5.29.0",
    "@taiga-ui/cdk": "^5.29.0",
    "@taiga-ui/core": "^5.29.0",
    "@taiga-ui/icons": "^5.29.0",
    "@taiga-ui/kit": "^5.29.0",
    "csv-parse": "^7.0.3",
    "fast-average-color": "^9.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@lunapaint/png-codec": "^0.2.0",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "csv-writer": "^1.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "svg-sprite": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
